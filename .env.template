# Copy this file to .env and fill in your values

# ── Required ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Robot ───────────────────────────────────────────────────────────────────
REACHY_IP=192.168.1.100

# ── Camera ──────────────────────────────────────────────────────────────────
CAMERA_INDEX=0

# ── Face recognition ────────────────────────────────────────────────────────
FACE_CONFIDENCE_THRESHOLD=0.5
ENCODINGS_PATH=face_encodings.pkl

# ── Database ────────────────────────────────────────────────────────────────
DB_PATH=reachy_memory.db

# ── Web search (optional — DuckDuckGo works without a key) ──────────────────
# Set TAVILY_API_KEY for higher-quality search results
# Get a free key at: https://tavily.com
TAVILY_API_KEY=

# ── Vision ──────────────────────────────────────────────────────────────────
# Uses OPENAI_API_KEY (GPT-4o vision).  No extra key needed.
# Interval in seconds between automatic scene analyses:
# VISION_INTERVAL=10

# ── Text-to-Speech ───────────────────────────────────────────────────────────
# Voice: alloy | ash | coral | echo | fable | nova (default) | onyx | sage | shimmer
REACHY_VOICE=nova
# Speed multiplier 0.25–4.0 (default 1.0)
REACHY_SPEECH_SPEED=1.0
# Model: tts-1 (fast, default) or tts-1-hd (higher quality)
REACHY_TTS_MODEL=tts-1
