# Copy this file to .env and fill in your values

# ── Required ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Web search — REQUIRED for real-time queries ──────────────────────────────
# Tavily is the PRIMARY search backend used for prices, weather, news etc.
# Without this key, Reachy cannot answer "Bitcoin Kurs heute" or "Wetter Wien".
# Free key (1000 searches/month): https://app.tavily.com
TAVILY_API_KEY=tvly-...

# ── Robot ───────────────────────────────────────────────────────────────────
# reachy-mini SDK auto-detects USB (Lite) and WiFi (Wireless) connections.
# No IP address needed. Run without --no-robot to connect to the robot.

# ── Camera ──────────────────────────────────────────────────────────────────
CAMERA_INDEX=0

# ── Face recognition ────────────────────────────────────────────────────────
FACE_CONFIDENCE_THRESHOLD=0.5
ENCODINGS_PATH=face_encodings.pkl

# ── Database ────────────────────────────────────────────────────────────────
DB_PATH=reachy_memory.db

# ── Vision ──────────────────────────────────────────────────────────────────
# Uses OPENAI_API_KEY (GPT-4o vision). No extra key needed.
# Interval in seconds between automatic scene analyses (default 30):
# VISION_INTERVAL=30

# ── Text-to-Speech ───────────────────────────────────────────────────────────
# German-optimised voices (gpt-4o-mini-tts, best pronunciation):
#   onyx-de  — male,   deep and calm   ★ DEFAULT
#   nova-de  — female, warm and bright
# Standard voices (tts-1, faster):
#   alloy | ash | coral | echo | fable | nova | onyx | sage | shimmer
REACHY_VOICE=onyx-de
# Speed multiplier 0.25–4.0 — ignored for German-optimised voices (onyx-de, nova-de)
REACHY_SPEECH_SPEED=1.0
# Upgrade standard voices to higher quality: tts-1-hd (ignored for onyx-de/nova-de)
# REACHY_TTS_MODEL=tts-1-hd

# ── STT tuning ───────────────────────────────────────────────────────────────
# Raise if background noise triggers false detection; lower if speech is missed
# STT_THRESHOLD=0.005
# Whisper language hint (prevents German/English confusion)
# WHISPER_LANGUAGE=de
