# Copy this file to .env and fill in your values

# ── Required ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Robot ───────────────────────────────────────────────────────────────────
REACHY_IP=192.168.1.100

# ── Camera ──────────────────────────────────────────────────────────────────
CAMERA_INDEX=0

# ── Face recognition ────────────────────────────────────────────────────────
FACE_CONFIDENCE_THRESHOLD=0.5
ENCODINGS_PATH=face_encodings.pkl

# ── Database ────────────────────────────────────────────────────────────────
DB_PATH=reachy_memory.db

# ── Web search (optional — DuckDuckGo works without a key) ──────────────────
# Set TAVILY_API_KEY for higher-quality search results
# Get a free key at: https://tavily.com
TAVILY_API_KEY=

# ── Vision ──────────────────────────────────────────────────────────────────
# Uses OPENAI_API_KEY (GPT-4o vision).  No extra key needed.
# Interval in seconds between automatic scene analyses:
# VISION_INTERVAL=10
